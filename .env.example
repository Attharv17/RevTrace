# ── RevTrace API — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=RevTrace
VERSION=1.0.0
ENVIRONMENT=development         # development | staging | production
DEBUG=true
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── Database ──────────────────────────────────────────────────────────────────
# Docker / Production (PostgreSQL):
DATABASE_URL=postgresql+asyncpg://revtrace:revtrace@localhost:5432/revtrace

# Local dev fallback (SQLite — no Docker required):
# DATABASE_URL=sqlite+aiosqlite:///./revtrace.db

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS_STR=http://localhost:5173,http://localhost:3000

# ── Phase 7: AI Investigation Agent ───────────────────────────────────────────
# Gemini API key — get a free key at: https://aistudio.google.com/app/apikey
# Leave empty to run in degraded mode (raw DB data, no LLM synthesis).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
